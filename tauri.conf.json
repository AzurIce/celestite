{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "celestite",
  "version": "0.1.0",
  "identifier": "com.azurice.celestite",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "web"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "web"
    },
    "frontendDist": "web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "celestite",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
